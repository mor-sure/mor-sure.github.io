---
import { getImage } from 'astro:assets';
import site from '../data/site.json';
import { PAGE_WIDTH, FRAME_RATIO } from '../lib/scale';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Used for the social preview; pages pass their most representative image. */
  image?: ImageMetadata;
}

const { title, description = site.tagline, image } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;

const canonical = new URL(Astro.url.pathname, Astro.site);
const preview = image ? await getImage({ src: image, width: 1200, format: 'jpeg' }) : undefined;
const previewUrl = preview ? new URL(preview.src, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
 <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: site.name,
        url: new URL('/', Astro.site).href,
      })}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    {previewUrl && <meta property="og:image" content={previewUrl} />}
    <meta name="twitter:card" content={previewUrl ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body style={`--column: ${PAGE_WIDTH}px; --frame-ratio: ${FRAME_RATIO}`}>

<header class="site-header column"> 
<h1 class="site-name"><a href="/">{site.name}</a></h1>
<a href="#" id="bio-toggle" class="site-line">about</a>
<a href={`mailto:${site.email}`} 
class="site-line">{site.email}</a> 
<a href={site.instagram_url} 
class="site-line" target="_blank" rel="noopener">{site.instagram}</a> 
<a href={site.bandcamp_url} 
class="site-line" target="_blank" rel="noopener">bandcamp</a> 
</header>

<div id="lightbox" class="lightbox">
  <button class="lightbox-close" aria-label="Close">×</button>
  <img class="lightbox-img" alt="" />
</div>

    <main class="column">
      <slot />
    </main>
<script>
document.getElementById('bio-toggle')?.addEventListener('click', (e) => {
  e.preventDefault();
  e.stopPropagation();
  if (document.body.classList.contains('copyright-mode')) {
    document.body.classList.remove('copyright-mode');
  } else {
    document.body.classList.toggle('bio-mode');
  }
});
document.getElementById('copyright-toggle')?.addEventListener('click', (e) => {
  e.preventDefault();
  e.stopPropagation();
  document.body.classList.toggle('copyright-mode');
  document.body.classList.remove('bio-mode');
});
document.addEventListener('click', (e) => {
  const target = e.target as Element;
  if (document.body.classList.contains('bio-mode') && !target?.closest('#bio-toggle')) {
    document.body.classList.remove('bio-mode');
  }
  if (document.body.classList.contains('copyright-mode') && !target?.closest('#copyright-toggle')) {
    document.body.classList.remove('copyright-mode');
  }
});
  // Balayage du doigt : le défilement horizontal des images passe aussi le projet en couleur.
  // Le défilement ne remonte pas dans le DOM, donc on l'écoute en phase de capture.
  document.addEventListener(
    'scroll',
    (e) => {
      const slides = e.target instanceof HTMLElement ? e.target.closest('.slides') : null;
      const work = slides?.closest<HTMLElement>('.work');
      if (work && work.querySelector('.nav')) work.dataset.color = '';
    },
    { capture: true, passive: true }
  );
</script>
<script>
  let activeStep: ((direction: 1 | -1) => void) | null = null;

  function closeLightbox() {
    document.getElementById('lightbox')?.classList.remove('active');
    activeStep = null;
  }

  function openLightbox(getActiveSlide: () => HTMLElement | undefined, step: (direction: 1 | -1) => void) {
    const box = document.getElementById('lightbox')!;
    const img = box.querySelector<HTMLImageElement>('.lightbox-img')!;

    const render = () => {
      const slide = getActiveSlide();
      const full = slide?.dataset.full;
      const inline = slide?.querySelector('img');
      if (!full && !inline) return;
      img.src = full || inline!.currentSrc || inline!.src;
      img.alt = inline?.alt ?? '';
    };

    activeStep = (direction) => {
      step(direction);
      render();
    };
    render();
    box.classList.add('active');
  }

  document.getElementById('lightbox')?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.lightbox-close')) {
      closeLightbox();
      return;
    }
    activeStep?.(1);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowRight') activeStep?.(1);
    if (e.key === 'ArrowLeft') activeStep?.(-1);
  });

  (window as any).openLightbox = openLightbox;

  // Téléphone : un projet passe en couleur dès qu'on touche une flèche ou l'image
  // (projets à plusieurs images seulement). Il repart en noir et blanc quand on
  // plie ou déplie une ligne, ou avec Expand All / Collapse All.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    if (target.closest('#toggle-all')) {
      document.querySelectorAll<HTMLElement>('[data-color]').forEach((w) => delete w.dataset.color);
      return;
    }

    const work = target.closest<HTMLElement>('.work');
    if (!work) return;

    if (target.closest('.work-line')) {
      delete work.dataset.color;
      return;
    }

    const onFrame = target.closest('.frame') && !target.closest('.expand');
    if (onFrame && work.querySelector('.nav')) work.dataset.color = '';
  });
</script>
<footer style="text-align: center; padding: var(--space-4) 0;">
  <a href="#" id="copyright-toggle" class="footer-copyright">© 2026</a>
</footer>
  </body>
</html>

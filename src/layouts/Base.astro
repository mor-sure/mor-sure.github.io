---
import { getImage } from 'astro:assets';
import site from '../data/site.json';
import { PAGE_WIDTH, FRAME_RATIO } from '../lib/scale';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Used for the social preview; pages pass their most representative image. */
  image?: ImageMetadata;
}

const { title, description = site.tagline, image } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;

const canonical = new URL(Astro.url.pathname, Astro.site);
const preview = image ? await getImage({ src: image, width: 1200, format: 'jpeg' }) : undefined;
const previewUrl = preview ? new URL(preview.src, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    {previewUrl && <meta property="og:image" content={previewUrl} />}
    <meta name="twitter:card" content={previewUrl ? 'summary_large_image' : 'summary'} />
  </head>
  <body style={`--column: ${PAGE_WIDTH}px; --frame-ratio: ${FRAME_RATIO}`}>

<header class="site-header column"> 
<span class="site-name" id="bio-toggle">{site.name}</span> 
<a href={`mailto:${site.email}`} 
class="site-line">{site.email}</a> 
<a href={site.instagram_url} 
class="site-line" target="_blank" rel="noopener">{site.instagram}</a> 
<a href={site.bandcamp_url} 
class="site-line" target="_blank" rel="noopener">bandcamp</a> 
<a href="#" class="site-line" id="toggle-all">Tout déplier</a>
</header>

    <main class="column">
      <slot />
    </main>
<script>
document.getElementById('bio-toggle')?.addEventListener('click', (e) => {
  e.stopPropagation();
  document.body.classList.toggle('bio-mode');
});

document.addEventListener('click', (e) => {
  if (document.body.classList.contains('bio-mode') && !(e.target as Element)?.closest('#bio-toggle')) {
    document.body.classList.remove('bio-mode');
  }
});
const toggleAllBtn = document.getElementById('toggle-all');
toggleAllBtn?.addEventListener('click', (e) => {
  e.preventDefault();
  const works = document.querySelectorAll('.work');
  const anyCollapsed = [...works].some((w) => !w.classList.contains('expanded'));
  works.forEach((w) => w.classList.toggle('expanded', anyCollapsed));
  toggleAllBtn.textContent = anyCollapsed ? 'Tout replier' : 'Tout déplier';
});
</script>
  </body>
</html>

---
import type { CollectionEntry } from 'astro:content';
type Work = CollectionEntry<'works'>;
export type OnlineWorkEntry = Omit<Work, 'data'> & { data: Extract<Work['data'], { type: 'online' }> };
interface Props {
  work: OnlineWorkEntry;
}
const { work } = Astro.props;
const { title, date, url, categories } = work.data;
---
<figure class="work work-online" data-categories={categories?.join(' ') ?? ''}>
  <a class="work-line" href={url} target="_blank" rel="noopener">
    <span class="work-date" set:html={date.slice(2).replace('-', '.')} />
    <span class="work-title" set:html={` ${title}.`} />
  </a>
</figure>
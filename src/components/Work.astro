---
import type { CollectionEntry } from 'astro:content';
import PrintWork, { type PrintWorkEntry } from './PrintWork.astro';
import WebWork, { type OnlineWorkEntry } from './WebWork.astro';

interface Props {
  work: CollectionEntry<'works'>;
  /** Set on the first work only: its opening image is the LCP image. */
  eager?: boolean;
}

const { work, eager = false } = Astro.props;
const isOnline = work.data.type === 'online';
---

{
  // TS doesn't propagate the `work.data.type` narrowing above to `work`
  // itself once it crosses a JSX prop boundary — these casts are exactly as
  // safe as the runtime check on the line above, no more.
  isOnline ? (
    <WebWork work={work as OnlineWorkEntry} eager={eager} />
  ) : (
    <PrintWork work={work as PrintWorkEntry} eager={eager} />
  )
}

---
import type { CollectionEntry } from 'astro:content';
import PrintWork, { type PrintWorkEntry } from './PrintWork.astro';
import WebWork, { type OnlineWorkEntry } from './WebWork.astro';
import EventWork, { type EventWorkEntry } from './EventWork.astro';
import RecordWork, { type RecordWorkEntry } from './RecordWork.astro';
interface Props {
  work: CollectionEntry<'works'>;
  eager?: boolean;
}
const { work, eager = false } = Astro.props;
---
{
  work.data.type === 'online' ? (
    <WebWork work={work as OnlineWorkEntry} />
  ) : work.data.type === 'event' ? (
    <EventWork work={work as EventWorkEntry} eager={eager} />
  ) : work.data.type === 'record' ? (
    <RecordWork work={work as RecordWorkEntry} eager={eager} />
  ) : (
    <PrintWork work={work as PrintWorkEntry} eager={eager} />
  )
}
---
import type { CollectionEntry } from 'astro:content';
import PrintWork from './PrintWork.astro';
import WebWork from './WebWork.astro';

interface Props {
  work: CollectionEntry<'works'>;
  /** Set on the first work only: its opening image is the LCP image. */
  eager?: boolean;
}

const { work, eager = false } = Astro.props;
---

{work.data.type === 'online' ? <WebWork work={work} eager={eager} /> : <PrintWork work={work} eager={eager} />}

---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Work from '../components/Work.astro';
import site from '../data/site.json';
import { checkAspect, PAGE_WIDTH } from '../lib/scale';

const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.localeCompare(a.data.date)
);

checkAspect(works);

// The first work's opening image doubles as the social preview, whichever
// shape that work is.
const firstWork = works[0]?.data;
const preview =
  firstWork &&
  (firstWork.type === 'online'
    ? firstWork.image
    : firstWork.type === 'event'
      ? firstWork.event_images[0]?.src
      : firstWork.images[0]?.src);

// site.about carries inline HTML (e.g. <i> for a book title) rendered as-is
// below via set:html — it's Martin's own trusted content, not user input.
const paragraphs = site.about.split('\n\n');

// site.json is plain data, so the photo path can't use the image() schema
// helper. Globbing src/assets/uploads keeps it CMS-editable while still going
// through Astro's image pipeline.
const uploads = import.meta.glob<{ default: ImageMetadata }>('/src/assets/uploads/**');
const entry = site.photo ? uploads[site.photo] : undefined;
const photo = entry ? (await entry()).default : undefined;
---

<Base image={preview}>
<a href="#" id="toggle-all" class="toggle-all">Expand All</a>
{works.map((work, i) => <Work work={work} eager={i === 0} />)}

  <section class="about" id="bio">
    {
      photo && (
        <Picture
          src={photo}
          widths={[PAGE_WIDTH, PAGE_WIDTH * 2]}
          sizes={`(min-width: ${PAGE_WIDTH}px) ${PAGE_WIDTH}px, 100vw`}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          alt={site.name}
          loading="lazy"
        />
      )
    }
    {site.photo_credit && <p class="about-credit">{site.photo_credit}</p>}
    {paragraphs.map((paragraph) => <p set:html={paragraph} />)}
  </section>
<section class="copyright-page" id="copyright">
  <p>© 2026 Martin Sigler. All rights reserved. All content on this site (including text, photography, layout, and design) is the property of Martin Sigler unless otherwise credited. Where a contributor is named (photography, artwork, etc.), rights remain with that contributor. No part of this site may be reproduced, distributed, or used in any form without prior written permission from the relevant rights holder.</p>
</section>
<script>
  const toggleAllBtn = document.getElementById('toggle-all');
  toggleAllBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    const works = document.querySelectorAll('.work');
    const anyCollapsed = [...works].some((w) => !w.classList.contains('expanded'));
    works.forEach((w) => w.classList.toggle('expanded', anyCollapsed));
    toggleAllBtn.textContent = anyCollapsed ? 'Collapse All' : 'Expand All';
  });
</script>
</Base>

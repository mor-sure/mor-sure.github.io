---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Work from '../components/Work.astro';
import { scaleFor, checkAspect } from '../lib/scale';

const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

checkAspect(works);

// null when there are no works to measure.
const scale = scaleFor(works);

// The opening cover doubles as the social preview.
const preview = works[0]?.data.images[0]?.src;
---

<Base image={preview}>
  {
    scale && (
      <div style={`--mm: ${scale.mm}px; --box-h: ${scale.boxH}px`}>
        {works.map((work, i) => (
          <Work work={work} mm={scale.mm} eager={i === 0} />
        ))}
      </div>
    )
  }
</Base>

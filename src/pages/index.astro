---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Work from '../components/Work.astro';
import { checkAspect } from '../lib/scale';

const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

checkAspect(works);

// The opening cover doubles as the social preview.
const preview = works[0]?.data.images[0]?.src;
---

<Base image={preview}>
  {works.map((work, i) => <Work work={work} eager={i === 0} />)}
</Base>
